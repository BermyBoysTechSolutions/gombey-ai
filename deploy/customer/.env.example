COMPOSE_PROJECT_NAME=gombey_customer_example

# Set a DNS A record pointing at this customer's VPS.
SITE_DOMAIN=chat.customer.example
ACME_EMAIL=ops@example.com

GOMBEY_BRAND_NAME=Gombey AI
GOMBEY_BRAND_DESCRIPTION=Dedicated AI workspace for your business

# Pinned app release and companion images. Upgrade only after acceptance tests.
LIBRECHAT_IMAGE=ghcr.io/librechat-ai/librechat:v0.8.8
RAG_API_IMAGE=registry.librechat.ai/librechat-ai/librechat-rag-api-dev-lite:latest@sha256:3577689eedb1a74d4de69d70cee70b4cd42a9375ad74cdd5238ffc19a97392e3
MONGO_IMAGE=mongo:8.0.20
MEILI_IMAGE=getmeili/meilisearch:v1.35.1
VECTORDB_IMAGE=pgvector/pgvector:0.8.0-pg15-trixie
CADDY_IMAGE=caddy:2.10.2-alpine

# customer-init.sh replaces every REPLACE_ME value with a unique random secret.
MONGO_ROOT_USERNAME=gombey-root
MONGO_ROOT_PASSWORD=REPLACE_ME
MONGO_DATABASE=GombeyAI
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=REPLACE_ME
MEILI_MASTER_KEY=REPLACE_ME
JWT_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
CREDS_KEY=REPLACE_ME
CREDS_IV=REPLACE_ME

# Replace with the customer's own OpenAI API key before the public deployment.
# This is API billing, not a ChatGPT subscription.
OPENAI_API_KEY=REPLACE_WITH_CUSTOMER_OWNED_OPENAI_API_KEY
ALLOW_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
