# Private proof mode. Copy this file to .env.private and replace the secrets.
# This file is intentionally separate from the default OpenRouter deployment.
GOMBEY_ENV_FILE=.env.private
LIBRECHAT_CONFIG_FILE=librechat.private.yaml

# The API container reaches Ollama on the host through this OpenAI-compatible URL.
# On a customer deployment, use the private Ollama service/host address instead.
OLLAMA_BASE_URL=http://ollama:11434/v1
# The host-side proof script uses this address; the private containers use OLLAMA_BASE_URL.
PRIVATE_PROOF_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=gemma3:12b

APP_TITLE=Gombey AI Private
APP_FAVICON=/images/gombey_logo.png
CUSTOM_FOOTER=Gombey AI Private Deployment

DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# Generate unique values for every deployment with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret
CREDS_KEY=replace-with-a-random-32-character-key
CREDS_IV=replace-with-a-random-initialization-vector

ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=true
ALLOW_UNVERIFIED_EMAIL_LOGIN=true

MONGO_URI=mongodb://mongodb:27017/GombeyAI
NODE_ENV=production
CONFIG_PATH=librechat.yaml
HOST=0.0.0.0
